<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="QSurfer.Avalonia.ConfirmationWindow"
        Width="440"
        Height="190"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="22" RowDefinitions="*,Auto" RowSpacing="16">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" VerticalAlignment="Center" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="Cancel_Click" />
      <Button x:Name="ConfirmButton" Classes="primary" Click="Confirm_Click" />
    </StackPanel>
  </Grid>
</Window>
