<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="QSurfer.Avalonia.HelpWindow"
        Title="QSurfer Help"
        Width="1080"
        Height="760"
        MinWidth="800"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top" Classes="app-header">
      <StackPanel Spacing="3">
        <TextBlock Text="QSurfer Help" Classes="app-title" />
        <TextBlock Text="Search, browse, recover, and manage shared files." Classes="app-subtitle" />
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Classes="statusbar">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
        <Button Content="Close" Click="Close_Click" />
        <TextBlock Grid.Column="1" Text="QSurfer" Classes="field-label" VerticalAlignment="Center" />
        <Button Grid.Column="2" Content="GitHub" Click="GitHub_Click" ToolTip.Tip="Open the QSurfer project page" />
        <Button Grid.Column="3" Content="Donate" Click="Donate_Click" ToolTip.Tip="Support QSurfer through PayPal" />
      </Grid>
    </Border>
    <Grid ColumnDefinitions="245,1,*">
      <Border Classes="side-pane" Padding="12" BorderBrush="{DynamicResource QSurfer.SurfaceBorder}" BorderThickness="0,0,1,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Help topics" Classes="panel-title" Margin="0,0,0,10" />
          <TreeView x:Name="TopicTree" SelectionChanged="TopicTree_SelectionChanged">
            <TreeViewItem Header="Getting started" Tag="getting-started" IsSelected="True" />
            <TreeViewItem Header="Main window controls" Tag="main-controls" />
            <TreeViewItem Header="Search" Tag="search">
              <TreeViewItem Header="Filters and dates" Tag="filters" />
              <TreeViewItem Header="Search folders" Tag="search-folders" />
              <TreeViewItem Header="Results and sorting" Tag="results" />
            </TreeViewItem>
            <TreeViewItem Header="Browse folders" Tag="browse">
              <TreeViewItem Header="Navigation and mapped drives" Tag="navigation" />
              <TreeViewItem Header="File operations" Tag="file-operations" />
            </TreeViewItem>
            <TreeViewItem Header="Favorites and saved searches" Tag="favorites" />
            <TreeViewItem Header="Preview files" Tag="preview" />
            <TreeViewItem Header="Recovery" Tag="recovery">
              <TreeViewItem Header="Recycle Bin" Tag="recycle-bin" />
              <TreeViewItem Header="Version history" Tag="version-history" />
            </TreeViewItem>
            <TreeViewItem Header="Settings" Tag="settings">
              <TreeViewItem Header="Connection" Tag="connection-settings" />
              <TreeViewItem Header="Behavior" Tag="behavior-settings" />
              <TreeViewItem Header="Appearance" Tag="appearance-settings" />
              <TreeViewItem Header="Path mappings" Tag="mapping-settings" />
              <TreeViewItem Header="Rules and history" Tag="rules-history-settings" />
            </TreeViewItem>
            <TreeViewItem Header="Keyboard shortcuts" Tag="shortcuts" />
            <TreeViewItem Header="Troubleshooting" Tag="troubleshooting" />
          </TreeView>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="5" Background="{DynamicResource QSurfer.SurfaceBorder}" />
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,20">
        <StackPanel MaxWidth="760">
          <StackPanel x:Name="GettingStartedTopic" Spacing="12">
            <TextBlock Text="Getting started" Classes="help-topic-title" />
            <TextBlock Text="QSurfer combines indexed search and familiar file browsing in one workspace. Each tab can keep an active search or an open folder, and you can move a tab into its own window when you need more room." TextWrapping="Wrap" Classes="help-copy" />
            <Border Classes="settings-note"><StackPanel Spacing="5"><TextBlock Text="First connection" FontWeight="SemiBold" /><TextBlock Text="Open Settings and configure Qsirch, QIndexer, or both. QSurfer uses those services only for search and uses your normal network permissions for opening and browsing files." TextWrapping="Wrap" Classes="help-copy" /></StackPanel></Border>
            <TextBlock Text="Use the search field for file and folder names. Use the address field to browse a mapped drive or UNC folder. Click either field, or its tab glyph, to switch what that tab is showing." TextWrapping="Wrap" Classes="help-copy" />
          </StackPanel>
          <StackPanel x:Name="MainControlsTopic" IsVisible="False" Spacing="12"><TextBlock Text="Main window controls" Classes="help-topic-title" /><TextBlock Text="At the top, the folder button shows the selected item in your normal file manager. The circular arrow refreshes the current folder or Favorites. Preview shows or hides the right-side preview pane. Favorites and Navigation show or hide their own left-side sections; they work independently." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="Each tab has a small search or folder glyph at its left. Click that glyph to switch the tab between its saved search and its current folder. The pin keeps a search tab for the next time QSurfer starts. The X closes only that tab. The plus button makes a fresh, empty search tab." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="The address field is for a folder location such as X:\\Cases or a network path. Press Enter after typing one. The search field is for words such as smith, contract, or invoice. Press Enter or choose Search. Clear empties the query, results, and folder selections for that tab. Stop asks QSurfer to stop the search that is currently running." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="The left and right arrows move through folders you already visited in this tab. Up moves one folder higher. The small recent-search button beside Search opens recent words you searched for; it does not reopen a folder or change its access." TextWrapping="Wrap" Classes="help-copy" /></StackPanel>
          <StackPanel x:Name="SearchTopic" IsVisible="False" Spacing="12"><TextBlock Text="Search" Classes="help-topic-title" /><TextBlock Text="Enter a file or folder name and press Enter or Search. With Search contents off, QSurfer asks enabled providers for name and path matches. This is the fastest and most predictable way to find a known file, person, matter, or folder." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="With Search contents on, QSurfer may also return files whose indexed text contains the words. This can find a phrase inside a PDF or Word document, but it is broader and can return files whose names do not mention the term. Turn it off again when you only want names." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="Exact match off permits partial word matches, so apple can match Appleton. Exact match on keeps name searches to whole words, so pie does not also return Pierce. With Search contents also on, QSurfer sends the complete quoted phrase to enabled providers, so john doe proceeding looks for that phrase in indexed document text. Content matching still depends on the provider having indexed the file, including OCR for scanned documents." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="Select one or more file types to keep only those result types. Select Folders when matching folder names should be returned too. Changing Exact match or Search contents reruns the active query. A new query clears the previous results in that tab so old matches do not obscure incoming results." TextWrapping="Wrap" Classes="help-copy" /></StackPanel>
          <StackPanel x:Name="FiltersTopic" IsVisible="False" Spacing="12"><TextBlock Text="Filters and dates" Classes="help-topic-title" /><TextBlock Text="From and To narrow matches by the item's modified date. Leave From blank and keep To set to today to search all available dates. Entering a future date is not supported." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="The quick date menu is a convenience filter for common ranges such as today, this week, this month, and recent months. Selecting a range fills the date controls; you can still refine the dates manually afterward." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="Clear filters resets file type, Exact match, Search contents, dates, and folder scope without closing the tab, changing Arrange or View, or discarding results." TextWrapping="Wrap" Classes="help-copy" /></StackPanel>
          <StackPanel x:Name="SearchFoldersTopic" IsVisible="False" Spacing="12"><TextBlock Text="Search folders" Classes="help-topic-title" /><TextBlock Text="Use the Navigation tree to keep a search inside the folders that matter. Shift+Click a folder to include it. Shift+Click another included folder adds it too, so one search can cover several matters or departments." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="When a folder is already inside an included branch, Shift+Click it excludes that branch. Shift+Alt+Click always toggles an exclusion directly, including when no folders have been included. This is useful for a broad search that should skip one archive or confidential branch." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="The active search displays included folders in accent color and excluded folders in gray below the filters. Use the plus button to add another path, a switch to change an entry from included to excluded, and its minus button to remove it. A more-specific included child remains included when a parent is excluded. Clear removes both kinds of selection for that tab. Saved searches and pinned tabs preserve the selections. You can change both modifier-click gestures in Settings, Shortcut, Navigation scope gestures." TextWrapping="Wrap" Classes="help-copy" /></StackPanel>
          <StackPanel x:Name="ResultsTopic" IsVisible="False" Spacing="12"><TextBlock Text="Results and sorting" Classes="help-topic-title" /><TextBlock Text="View changes how the same results look. Details is best for comparing names, locations, dates, types, and sizes. List is compact. Small icons and Large icons are better when filenames or visual file types are easier to recognize than columns. Changing View never changes a file or reruns the search." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="Arrange chooses the default order for the current tab. Folder groups puts folders first, alphabetically, then files. Recentness puts newer files first. Name, Location, Date modified, Type, and Size sort by that one thing. In Details, clicking a column title is a quick way to sort by that column; click it again to reverse the order." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="Load more asks the NAS for another batch of the same search. It does not start over and it does not lose the filters already chosen. Use it when the status says there are more results. Stop cancels the active request; the results already displayed remain there." TextWrapping="Wrap" Classes="help-copy" /></StackPanel>
          <StackPanel x:Name="BrowseTopic" IsVisible="False" Spacing="12"><TextBlock Text="Browse folders" Classes="help-topic-title" /><TextBlock Text="Double-click a folder from results or Navigation to browse it in the current tab. The Back, Forward, Up, and Refresh controls work like Explorer. Double-click a file to open it in its normal application." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="Searches and browsing are not separate modes. A tab keeps its search results while you inspect a folder, so switch back by clicking the search field or its tab glyph." TextWrapping="Wrap" Classes="help-copy" /></StackPanel>
          <StackPanel x:Name="NavigationTopic" IsVisible="False" Spacing="12"><TextBlock Text="Navigation and mapped drives" Classes="help-topic-title" /><TextBlock Text="Navigation lists common personal folders first, then mapped drives, and accessible NAS shares without a mapping. When a NAS share has a mapped drive, QSurfer uses the drive letter for browsing, opening, and showing files." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="Path mappings translate the internal share path reported by the NAS search service into the location people use. A mapping applies to every folder below it." TextWrapping="Wrap" Classes="help-copy" /></StackPanel>
          <StackPanel x:Name="FileOperationsTopic" IsVisible="False" Spacing="12"><TextBlock Text="File operations" Classes="help-topic-title" /><TextBlock Text="Right-click files and folders for standard file-manager actions. Open launches the file in its normal application. Show opens its containing folder and selects it. Copy copies the item itself so you can paste it elsewhere. Copy full path copies the written location instead. Cut marks an item to move when you paste it somewhere else." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="Rename changes the displayed filename. Delete sends the item through the file system's normal delete behavior; on a NAS this usually means the NAS recycle bin when that share has one enabled. New folder makes an empty folder in the current browse location. Create shortcut makes a link, not a second copy of the item. Properties opens the system file information window." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="QSurfer does not bypass normal permissions. If an action is unavailable or fails, the same user likely cannot perform it in Explorer either. Settings lets you change keyboard shortcuts for common browse actions." TextWrapping="Wrap" Classes="help-copy" /></StackPanel>
          <StackPanel x:Name="FavoritesTopic" IsVisible="False" Spacing="12"><TextBlock Text="Favorites and saved searches" Classes="help-topic-title" /><TextBlock Text="Use the star beside a result, or Add or remove Favorite in the right-click menu, to remember a file or folder you use often. A favorite is a pointer to the original item; it does not copy the file. Removing a favorite never removes the actual item." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="Recent searches are only the words you searched for. Right-click a recent search to remove it. Saved searches remember the query plus its filters, dates, arrangement, view, and folder include or exclude choices. Opening a saved search opens a new tab, so it never wipes out the tab you were already using." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="Pinning a tab means QSurfer reopens that search the next time it starts. The search runs after the window is ready. A pin saves the search setup, not a frozen copy of old results." TextWrapping="Wrap" Classes="help-copy" /></StackPanel>
          <StackPanel x:Name="PreviewTopic" IsVisible="False" Spacing="12"><TextBlock Text="Preview files" Classes="help-topic-title" /><TextBlock Text="The Preview pane uses installed Windows preview handlers where available. Select an item and wait briefly while QSurfer prepares the preview. Images can preview directly; unsupported file types still show useful details and remain available to Open or Show." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="Preview preparation runs separately from active search work, so you can keep searching or browsing while a document initializes." TextWrapping="Wrap" Classes="help-copy" /></StackPanel>
          <StackPanel x:Name="RecoveryTopic" IsVisible="False" Spacing="12"><TextBlock Text="Recovery" Classes="help-topic-title" /><TextBlock Text="QSurfer provides two recovery paths when the NAS exposes them: Recycle Bin for deleted items and Version history for snapshot copies. Recovery always asks for confirmation before writing to a live location." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="Folder restores are deliberately more restricted than file restores. They require a one-session override and a typed confirmation because a folder may replace many live files." TextWrapping="Wrap" Classes="help-copy" /></StackPanel>
          <StackPanel x:Name="RecycleBinTopic" IsVisible="False" Spacing="12"><TextBlock Text="Recycle Bin" Classes="help-topic-title" /><TextBlock Text="QSurfer labels NAS @Recycle folders as Recycle Bin. Enable Flatten recycle bin to show deleted files directly with their original locations, ordered with the newest changes first. Use Restore to put a selected item back." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="Temporary and hidden files stay hidden by default, including in the Recycle Bin. Enable Show hidden and temporary files in Settings only when investigating them." TextWrapping="Wrap" Classes="help-copy" /></StackPanel>
          <StackPanel x:Name="VersionHistoryTopic" IsVisible="False" Spacing="12"><TextBlock Text="Version history" Classes="help-topic-title" /><TextBlock Text="Select a file or folder, then choose Version history. QSurfer checks accessible NAS @Recently-Snapshot folders and lists older copies by timestamp. Opening a version is read-only." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="Recover copy writes a separately named copy to a location you choose. Restore original is controlled in Settings, always confirms overwrites, and keeps the replaced live item as a separately named backup." TextWrapping="Wrap" Classes="help-copy" /></StackPanel>
          <StackPanel x:Name="SettingsTopic" IsVisible="False" Spacing="12"><TextBlock Text="Settings" Classes="help-topic-title" /><TextBlock Text="Settings are organized by connection, behavior, appearance, paths, rules, history, and keyboard shortcuts. Use the child topics in the tree for a plain-English explanation of each page." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="Connection and manual path mappings are kept for this computer. Favorites, saved searches, and history belong to the current user." TextWrapping="Wrap" Classes="help-copy" /></StackPanel>
          <StackPanel x:Name="ConnectionSettingsTopic" IsVisible="False" Spacing="12"><TextBlock Text="Settings: Connection" Classes="help-topic-title" /><TextBlock Text="Use Qsirch enables the NAS provider. NAS host or IP is its address; use the fully qualified NAS name when remote authentication or DNS requires it, or an IP address only when that is the dependable route from this computer. Its port, username, password, HTTPS, and certificate settings apply only to Qsirch." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="Use QIndexer enables the independent QIndexer provider. Give it the service host, port, and search token supplied by its administrator. Its HTTPS and certificate settings are separate from Qsirch. Turn on either provider or both. With both enabled, QSurfer asks both and combines the results; a temporary failure in one does not prevent the other from searching." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="Search-service credentials do not grant file access. Open, Show, browsing, copy, and recovery still use the signed-in user's normal SMB permissions." TextWrapping="Wrap" Classes="help-copy" /></StackPanel>
          <StackPanel x:Name="BehaviorSettingsTopic" IsVisible="False" Spacing="12"><TextBlock Text="Settings: Behavior" Classes="help-topic-title" /><TextBlock Text="Show in taskbar, Minimize to notification area, Exit to notification area, and Always on top control only the QSurfer window. Exit to notification area keeps QSurfer running when its close button is used; leave it off when close should really exit." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="Clear results when the search text is cleared removes a tab's visible results only when its query text is cleared. Search file contents by default pre-checks that option for new searches. Highlight matching text controls the yellow match emphasis in results. Show preview pane by default opens the Preview pane for new windows." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="Use NAS thumbnails asks the NAS for thumbnails when it can provide them. Show raw NAS recovery system folders exposes @Recently-Snapshot and @Recycle in ordinary views. Show QSurfer safety copies exposes backup copies QSurfer creates before a restore. Show hidden and temporary files reveals names beginning with ~ or ~$; keep it off for ordinary work." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="Flatten Recycle Bin lists deleted items from every recycle-bin child folder together and shows their original locations. Search result limit is the number QSurfer initially aims to display. Load more continues beyond it. Initial results controls the first visible batch; Additional results controls later batches. Folders opened at once limits the bulk Open in new QSurfer tabs action; its default of 15 avoids unexpectedly creating a wall of tabs. Smaller batches paint sooner, while larger batches reduce requests during broad searches. Search timeout is the maximum wait for one NAS search request." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="Default view and Default arrangement set the starting presentation for new tabs. Restore original location controls whether snapshot recovery may replace a live file. Folder restore remains blocked unless the one-session override is armed and its acknowledgement is typed exactly." TextWrapping="Wrap" Classes="help-copy" /></StackPanel>
          <StackPanel x:Name="AppearanceSettingsTopic" IsVisible="False" Spacing="12"><TextBlock Text="Settings: Appearance" Classes="help-topic-title" /><TextBlock Text="Display mode chooses Follow system, Light, or Dark. Follow system lets QSurfer change with the system theme; the other choices keep QSurfer fixed to that mode." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="Use the current system accent color applies the system accent to buttons, links, folder glyphs, and focus outlines. Turning it off restores QSurfer's saved custom accent without losing it." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="A color preset is a starting point. Custom preserves your edits. Main surface changes the primary panel color; Accent changes action and focus color; Selected result, Hover, and Match highlight change the corresponding result states. Enter a six- or eight-digit hexadecimal color, or click its swatch to use the picker. The previews show the result before you save." TextWrapping="Wrap" Classes="help-copy" /></StackPanel>
          <StackPanel x:Name="MappingSettingsTopic" IsVisible="False" Spacing="12"><TextBlock Text="Settings: Path mappings" Classes="help-topic-title" /><TextBlock Text="Search providers can report their own paths while the file system opens a mapped drive, network location, or mounted share. QSurfer automatically detects available network locations and uses them first. Detected mappings are not stored as manual rules." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="Use Map network share when a usable local path does not already exist. On Linux, enable Mount at boot when mounting an SMB share. QSurfer installs a root-owned credential file and a system-wide systemd mount, so the share is available after reboot even while QSurfer is closed. It remains mounted until the operating system unmounts it. Add a manual mapping only when a search-provider path must resolve to a different local location. A mapping for a parent folder covers everything below it, so avoid overlapping rules unless you have a very specific exception." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="Manual mappings are per computer. They solve path translation only; they do not create access rights. If the file system cannot open the mapped, network, or mounted location, QSurfer cannot bypass that permission problem." TextWrapping="Wrap" Classes="help-copy" /></StackPanel>
          <StackPanel x:Name="RulesHistorySettingsTopic" IsVisible="False" Spacing="12"><TextBlock Text="Settings: Rules and history" Classes="help-topic-title" /><TextBlock Text="Visibility rules hide matching QSurfer results and browse entries. They never grant access, change a file, or alter NAS permissions. Use wildcards such as @recycle* when you need to suppress a pattern. A global rule is reserved for an authorized local or domain administrator because it affects every QSurfer user." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="Personal rules can target the current user, the current computer, or both. Machine rules follow the computer name; user rules follow the signed-in account. A global rule intentionally keeps its user field blank." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="History stores recent and saved searches plus favorites in the current user's local database. Removing a saved search or favorite does not affect the NAS or any other user." TextWrapping="Wrap" Classes="help-copy" /></StackPanel>
          <StackPanel x:Name="ShortcutsTopic" IsVisible="False" Spacing="12"><TextBlock Text="Keyboard shortcuts" Classes="help-topic-title" /><TextBlock Text="The Shortcut settings page lets you record a preferred key or key combination for browsing actions and the global show or hide command. Press Esc while recording to clear a shortcut." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="Navigation scope gestures are configured separately because they are modifier-click actions: the default Include folder gesture is Shift+Click and Exclude folder is Shift+Alt+Click. Either can be disabled or reassigned." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="F1 opens Help. QSurfer warns when Windows reports a global shortcut is already in use." TextWrapping="Wrap" Classes="help-copy" /></StackPanel>
          <StackPanel x:Name="TroubleshootingTopic" IsVisible="False" Spacing="12"><TextBlock Text="Troubleshooting" Classes="help-topic-title" /><TextBlock Text="For search problems, check the NAS address, port, HTTPS setting, certificate setting, and search-service sign-in under Connection. A NAS status message is shown in the lower-right corner of the main window." TextWrapping="Wrap" Classes="help-copy" /><TextBlock Text="If Open or Show cannot find an item, confirm that its mapped, network, or mounted location is available, then review Path mappings. Preview availability depends on the supported preview providers installed for that file type." TextWrapping="Wrap" Classes="help-copy" /><Border Classes="settings-note"><StackPanel Spacing="5"><TextBlock Text="Need more help?" FontWeight="SemiBold" /><TextBlock Text="Use the GitHub button below for the project page, updates, and issue reporting." TextWrapping="Wrap" Classes="help-copy" /></StackPanel></Border></StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
