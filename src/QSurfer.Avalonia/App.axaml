<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:QSurfer.Avalonia.Converters"
             x:Class="QSurfer.Avalonia.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <converters:FileIconBrushConverter x:Key="FileIconBrush" />
      <!-- Fluent collapses idle scrollbar thumbs to 12.5% of their track. Keep the
           thumb usable without changing the scrollbar's layout footprint. -->
      <TransformOperations x:Key="VerticalSmallScrollThumbScaleTransform">scaleX(1)</TransformOperations>
      <TransformOperations x:Key="HorizontalSmallScrollThumbScaleTransform">scaleY(1)</TransformOperations>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="QSurfer.WindowBackground">#FFF4F7FB</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.PanelBackground">#FFFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.SubtleBackground">#FFF0F4F8</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.SurfaceBorder">#FFC6D0DC</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.MutedForeground">#FF4A5A6C</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.Accent">#FF0067B8</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.OnAccent">#FFFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.MatchHighlight">#FFFFE29A</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.SelectionBackground">#FFD7EBFF</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.SelectionForeground">#FF08243D</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.HoverBackground">#FFE8F3FD</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.InputBackground">#FFFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.InputBorder">#FF8495A8</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.HeaderBackground">#FFF7F9FB</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.ScrollTrack">#FFE2E8EF</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.ScrollThumb">#FF899AAC</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.IconOpen">#FF007C69</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.IconShow">#FF1769C2</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.IconPreview">#FF7046A8</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.IconFavorite">#FFA85C00</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.IconFavoritesPane">#FFB52E66</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.IconHelp">#FF166B9C</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.IconBrowse">#FF18724F</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="QSurfer.WindowBackground">#FF1B1E24</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.PanelBackground">#FF242830</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.SubtleBackground">#FF2D333D</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.SurfaceBorder">#FF454C57</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.MutedForeground">#FFB2BBC8</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.Accent">#FF36B9AD</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.OnAccent">#FF062D31</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.MatchHighlight">#FF725826</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.SelectionBackground">#FF27495F</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.SelectionForeground">#FFF6FAFF</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.HoverBackground">#FF2C3847</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.InputBackground">#FF1D232C</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.InputBorder">#FF546477</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.HeaderBackground">#FF20262F</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.ScrollTrack">#FF1A1E25</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.ScrollThumb">#FF65758A</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.IconOpen">#FF4DD5C6</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.IconShow">#FF6EA8FF</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.IconPreview">#FFC5A7FF</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.IconFavorite">#FFFFD166</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.IconFavoritesPane">#FFFF96B8</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.IconHelp">#FF80CFFF</SolidColorBrush>
          <SolidColorBrush x:Key="QSurfer.IconBrowse">#FF72D79C</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource QSurfer.WindowBackground}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Border.app-header">
      <Setter Property="Background" Value="{DynamicResource QSurfer.PanelBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.SurfaceBorder}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="16,10" />
    </Style>
    <Style Selector="TextBlock.app-title">
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.app-subtitle">
      <Setter Property="Foreground" Value="{DynamicResource QSurfer.MutedForeground}" />
    </Style>
    <Style Selector="Border.search-surface">
      <Setter Property="Background" Value="{DynamicResource QSurfer.PanelBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.SurfaceBorder}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="Border.side-pane">
      <Setter Property="Background" Value="{DynamicResource QSurfer.PanelBackground}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.address-suggestions-popup">
      <Setter Property="Background" Value="{DynamicResource QSurfer.PanelBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.InputBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="ListBox.address-suggestions-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.address-suggestions-list > ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="ListBox.address-suggestions-list > ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource QSurfer.HoverBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.SurfaceBorder}" />
    </Style>
    <Style Selector="ListBox.address-suggestions-list > ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource QSurfer.SelectionBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource QSurfer.SelectionForeground}" />
    </Style>
    <Style Selector="Button.address-suggestion-item">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.address-suggestion-item:pointerover">
      <Setter Property="Background" Value="{DynamicResource QSurfer.HoverBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.SurfaceBorder}" />
    </Style>
    <Style Selector="Button.address-suggestion-item.keyboard-selected">
      <Setter Property="Background" Value="{DynamicResource QSurfer.SelectionBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource QSurfer.SelectionForeground}" />
    </Style>
    <Style Selector="Border.color-swatch">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.SurfaceBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ColorPicker.theme-color-picker">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="IsAlphaEnabled" Value="False" />
      <Setter Property="IsAlphaVisible" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ProgressBar.drive-capacity /template/ Border#PART_Indicator">
      <Setter Property="Background" Value="{DynamicResource QSurfer.Accent}" />
    </Style>
    <Style Selector="ListBox.home-drive-list">
      <Setter Property="Padding" Value="16" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.home-drive-list > ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.home-drive-tile">
      <Setter Property="Width" Value="320" />
      <Setter Property="MinHeight" Value="82" />
      <Setter Property="Margin" Value="0,0,14,14" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Background" Value="{DynamicResource QSurfer.PanelBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.SurfaceBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ListBox.home-drive-list > ListBoxItem:pointerover Border.home-drive-tile">
      <Setter Property="Background" Value="{DynamicResource QSurfer.HoverBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.Accent}" />
    </Style>
    <Style Selector="ListBox.home-drive-list > ListBoxItem:selected Border.home-drive-tile">
      <Setter Property="Background" Value="{DynamicResource QSurfer.SelectionBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.Accent}" />
    </Style>
    <Style Selector="Border.theme-preview">
      <Setter Property="Padding" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="MinHeight" Value="78" />
    </Style>
    <Style Selector="Border.favorites-pane">
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.SurfaceBorder}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="Border.preview-pane">
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.SurfaceBorder}" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>
    <Style Selector="GridSplitter.side-pane-divider">
      <Setter Property="Background" Value="{DynamicResource QSurfer.PanelBackground}" />
    </Style>
    <Style Selector="GridSplitter.side-pane-divider:pointerover">
      <Setter Property="Background" Value="{DynamicResource QSurfer.SubtleBackground}" />
    </Style>
    <Style Selector="Border.search-tabs">
      <Setter Property="Background" Value="{DynamicResource QSurfer.PanelBackground}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="14,5,14,0" />
    </Style>
    <Style Selector="Border.search-tabs.drag-over">
      <Setter Property="Background" Value="{DynamicResource QSurfer.HoverBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.Accent}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <Style Selector="Border.tab-drag-ghost">
      <Setter Property="Background" Value="{DynamicResource QSurfer.SubtleBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.Accent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Opacity" Value="0.96" />
      <Setter Property="BoxShadow" Value="0 4 12 0 #66000000" />
    </Style>
    <Style Selector="TextBlock.tab-drag-ghost-hint">
      <Setter Property="Foreground" Value="{DynamicResource QSurfer.MutedForeground}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.command-bar">
      <Setter Property="Background" Value="{DynamicResource QSurfer.PanelBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.SurfaceBorder}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="14,6" />
    </Style>
    <Style Selector="Border.result-surface">
      <Setter Property="Background" Value="{DynamicResource QSurfer.PanelBackground}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.empty-state">
      <Setter Property="Background" Value="{DynamicResource QSurfer.PanelBackground}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="28" />
    </Style>
    <Style Selector="Border.action-bar">
      <Setter Property="Padding" Value="2,0" />
    </Style>
    <Style Selector="Border.statusbar">
      <Setter Property="Background" Value="{DynamicResource QSurfer.SubtleBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.SurfaceBorder}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="20,8" />
    </Style>
    <Style Selector="Border.settings-note">
      <Setter Property="Background" Value="{DynamicResource QSurfer.SubtleBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.SurfaceBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.scope-indicator">
      <Setter Property="Background" Value="{DynamicResource QSurfer.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.Accent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12,8,12,10" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="TextBlock.field-label">
      <Setter Property="Foreground" Value="{DynamicResource QSurfer.MutedForeground}" />
    </Style>
    <Style Selector="TextBlock.scope-included">
      <Setter Property="Foreground" Value="{DynamicResource QSurfer.Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.scope-excluded">
      <Setter Property="Foreground" Value="{DynamicResource QSurfer.MutedForeground}" />
    </Style>
    <Style Selector="TextBlock.scope-result-count">
      <Setter Property="Foreground" Value="{DynamicResource QSurfer.MutedForeground}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="Margin" Value="12,0,10,0" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style Selector="TextBlock.empty-title">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.empty-copy">
      <Setter Property="Foreground" Value="{DynamicResource QSurfer.MutedForeground}" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBlock.help-section-title">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,22,0,7" />
    </Style>
    <Style Selector="TextBlock.help-topic-title">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.help-copy">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="LineHeight" Value="21" />
    </Style>
    <Style Selector="TextBox.search-box">
      <Setter Property="Height" Value="40" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource QSurfer.InputBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.InputBorder}" />
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.Accent}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource QSurfer.InputBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.InputBorder}" />
    </Style>
    <Style Selector="TextBox.location-box">
      <Setter Property="Height" Value="40" />
    </Style>
    <Style Selector="Border.address-search-divider">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Background" Value="{DynamicResource QSurfer.SurfaceBorder}" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource QSurfer.Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource QSurfer.OnAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.tab-add">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tab-action">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.panel-action">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.side-pane-action">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.side-pane-action:pointerover /template/ Border">
      <Setter Property="Background" Value="{DynamicResource QSurfer.HoverBackground}" />
    </Style>
    <Style Selector="Button.side-pane-action.scope-add-pending /template/ Border">
      <Setter Property="Background" Value="{DynamicResource QSurfer.Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.Accent}" />
    </Style>
    <Style Selector="TextBlock.scope-action-glyph">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="LineHeight" Value="18" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.toolbar-icon">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.toolbar-icon:pointerover /template/ Border">
      <Setter Property="Background" Value="{DynamicResource QSurfer.HoverBackground}" />
    </Style>
    <Style Selector="Button.toolbar-icon.command-open, Button.side-pane-action.command-open">
      <Setter Property="Foreground" Value="{DynamicResource QSurfer.IconOpen}" />
    </Style>
    <Style Selector="Button.toolbar-icon.command-show, Button.side-pane-action.command-show">
      <Setter Property="Foreground" Value="{DynamicResource QSurfer.IconShow}" />
    </Style>
    <Style Selector="Button.toolbar-icon.command-preview">
      <Setter Property="Foreground" Value="{DynamicResource QSurfer.IconPreview}" />
    </Style>
    <Style Selector="Button.toolbar-icon.command-save, Button.result-favorite">
      <Setter Property="Foreground" Value="{DynamicResource QSurfer.IconFavorite}" />
    </Style>
    <Style Selector="Button.toolbar-icon.command-help">
      <Setter Property="Foreground" Value="{DynamicResource QSurfer.IconHelp}" />
    </Style>
    <Style Selector="Button.toolbar-pane-toggle">
      <Setter Property="Height" Value="34" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource QSurfer.IconFavoritesPane}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.toolbar-pane-toggle:pointerover /template/ Border">
      <Setter Property="Background" Value="{DynamicResource QSurfer.HoverBackground}" />
    </Style>
    <Style Selector="ToggleButton.toolbar-pane-toggle">
      <Setter Property="Height" Value="34" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource QSurfer.IconFavoritesPane}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.toolbar-pane-toggle:pointerover /template/ Border">
      <Setter Property="Background" Value="{DynamicResource QSurfer.HoverBackground}" />
    </Style>
    <Style Selector="ToggleButton.toolbar-pane-toggle:checked /template/ Border">
      <Setter Property="Background" Value="{DynamicResource QSurfer.SelectionBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.Accent}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.toolbar-pane-glyph">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.toolbar-pane-label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.browser-command-bar">
      <Setter Property="Background" Value="{DynamicResource QSurfer.SubtleBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.SurfaceBorder}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Button.tab-action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tab-action.pinned">
      <Setter Property="Background" Value="{DynamicResource QSurfer.Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.Accent}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.result-favorite">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.search-tab-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.search-tab-list > ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    <Style Selector="ListBox.search-tab-list > ListBoxItem:selected">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.search-tab-list > ListBoxItem:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.search-tab-list > ListBoxItem:selected:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.search-tab-list > ListBoxItem:focus">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.search-tab-item">
      <Setter Property="Background" Value="{DynamicResource QSurfer.SubtleBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.SurfaceBorder}" />
      <Setter Property="BorderThickness" Value="1,1,1,0" />
      <Setter Property="CornerRadius" Value="8,8,0,0" />
      <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style Selector="ListBox.search-tab-list > ListBoxItem:selected Border.search-tab-item">
      <Setter Property="Background" Value="{DynamicResource QSurfer.PanelBackground}" />
    </Style>
    <Style Selector="TextBlock.panel-title">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBlock.preview-title">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.preview-path">
      <Setter Property="Foreground" Value="{DynamicResource QSurfer.MutedForeground}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.file-glyph">
      <Setter Property="Foreground" Value="{DynamicResource QSurfer.Accent}" />
      <Setter Property="FontSize" Value="18" />
    </Style>
    <Style Selector="TextBlock.result-name">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.result-path">
      <Setter Property="Foreground" Value="{DynamicResource QSurfer.MutedForeground}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="ListBox.result-list">
      <Setter Property="Background" Value="{DynamicResource QSurfer.PanelBackground}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.recent-search-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.recent-search-list > ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="Border.result-icon-tile">
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.SurfaceBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource QSurfer.PanelBackground}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="TabControl">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="DataGrid">
      <Setter Property="Background" Value="{DynamicResource QSurfer.PanelBackground}" />
      <Setter Property="RowHeight" Value="34" />
      <Setter Property="GridLinesVisibility" Value="None" />
    </Style>
    <Style Selector="DataGridRow:selected">
      <Setter Property="Background" Value="{DynamicResource QSurfer.SelectionBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource QSurfer.SelectionForeground}" />
    </Style>
    <Style Selector="DataGridRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource QSurfer.HoverBackground}" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource QSurfer.HeaderBackground}" />
    </Style>
    <Style Selector="ListBoxItem:selected, TreeViewItem:selected">
      <Setter Property="Background" Value="{DynamicResource QSurfer.SelectionBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource QSurfer.SelectionForeground}" />
    </Style>
    <Style Selector="ListBox.home-drive-list > ListBoxItem:selected">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource QSurfer.Foreground}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover, TreeViewItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource QSurfer.HoverBackground}" />
    </Style>
    <Style Selector="ScrollBar">
      <Setter Property="Background" Value="{DynamicResource QSurfer.ScrollTrack}" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
      <Setter Property="Background" Value="{DynamicResource QSurfer.ScrollThumb}" />
      <Setter Property="MinWidth" Value="9" />
      <Setter Property="MinHeight" Value="9" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="DataGrid.results-grid DataGridCell">
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.SurfaceBorder}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="DataGrid.results-grid DataGridColumnHeader">
      <Setter Property="BorderBrush" Value="{DynamicResource QSurfer.SurfaceBorder}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
  </Application.Styles>
</Application>
