<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:QSurfer.Avalonia.Controls"
        x:Class="QSurfer.Avalonia.MainWindow"
        Title="QSurfer"
        Width="1280"
        Height="820"
        MinWidth="900"
        MinHeight="620">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border Classes="app-header">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="QSurfer" Classes="app-title" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="NAS search and browser" Classes="app-subtitle" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Classes="command-bar">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Content="&#xE8E5;" Classes="toolbar-icon command-open" Command="{Binding SelectedSearchTab.OpenCommand}" ToolTip.Tip="Open selected item" />
          <Button Content="&#xE8B7;" Classes="toolbar-icon command-show" Command="{Binding SelectedSearchTab.BrowseCommand}" ToolTip.Tip="Show selected item in File Explorer" />
          <Button Content="Restore" Classes="toolbar-pane-toggle" IsVisible="{Binding IsRecycleBinView}" Click="RestoreRecycle_Click" ToolTip.Tip="Restore selected Recycle Bin items to their original location" />
          <Button Content="&#xE81C;" Classes="toolbar-icon command-preview" Click="VersionHistory_Click" ToolTip.Tip="Version history" />
          <Border Width="1" Height="20" Background="{DynamicResource QSurfer.SurfaceBorder}" Margin="5,0" />
          <Button Classes="toolbar-pane-toggle" Command="{Binding TogglePreviewCommand}" ToolTip.Tip="Show or hide preview">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="&#xE890;" Classes="toolbar-pane-glyph" />
              <TextBlock Text="Preview" Classes="toolbar-pane-label" />
            </StackPanel>
          </Button>
          <Button Classes="toolbar-pane-toggle" Command="{Binding ToggleFavoritesCommand}" ToolTip.Tip="Show or hide Favorites">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="&#xE8A2;" Classes="toolbar-pane-glyph" />
              <TextBlock Text="Favorites" Classes="toolbar-pane-label" />
            </StackPanel>
          </Button>
          <Border Width="1" Height="20" Background="{DynamicResource QSurfer.SurfaceBorder}" Margin="5,0" />
          <Button Content="&#xE897;" Classes="toolbar-icon command-help" Click="Help_Click" ToolTip.Tip="Help" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="NAS connection needed" Foreground="#FFD06A55" VerticalAlignment="Center" IsVisible="{Binding NeedsConnection}" />
          <Button Content="&#xE713;" Classes="toolbar-icon" Click="Settings_Click" ToolTip.Tip="Settings" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid RowDefinitions="Auto,*" RowSpacing="0">
          <Border Classes="search-tabs">
            <DockPanel LastChildFill="False">
              <ListBox DockPanel.Dock="Left" Classes="search-tab-list" ItemsSource="{Binding SearchTabs}"
                       SelectedItem="{Binding SelectedSearchTab, Mode=TwoWay}"
                       Background="Transparent"
                       BorderThickness="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerTheme>
                  <ControlTheme TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,4,0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FocusAdorner" Value="{x:Null}" />
                    <Setter Property="Template">
                      <ControlTemplate>
                        <Border Name="PART_Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                          <ContentPresenter Name="PART_ContentPresenter"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            Padding="{TemplateBinding Padding}"
                                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                      </ControlTemplate>
                    </Setter>
                  </ControlTheme>
                </ListBox.ItemContainerTheme>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="search-tab-item">
                      <Border.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Quick save search" Command="{Binding SaveSearchCommand}" />
                          <MenuItem Header="Save search as..." Click="SaveSearchAs_Click" />
                        </ContextMenu>
                      </Border.ContextMenu>
                      <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Content="{Binding WorkspaceGlyph}" Classes="tab-action" FontFamily="Segoe MDL2 Assets" Tag="{Binding}" Click="ToggleTabWorkspace_Click" ToolTip.Tip="Switch between search results and folder browsing" />
                        <TextBlock Text="{Binding Title}" Width="106" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button Content="&#xE718;" Classes="tab-action" Tag="{Binding}" Click="ToggleTabPin_Click" ToolTip.Tip="Pin this search" />
                        <Button Content="&#xE711;" Classes="tab-action" Tag="{Binding}" Click="CloseSearchTab_Click" ToolTip.Tip="Close this search" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button DockPanel.Dock="Left" Content="&#xE710;" Classes="tab-add" Command="{Binding NewSearchTabCommand}" ToolTip.Tip="New search tab" />
            </DockPanel>
          </Border>

          <ContentControl Grid.Row="1" Content="{Binding SelectedSearchTab}">
            <ContentControl.ContentTemplate>
              <DataTemplate>
                <Grid RowDefinitions="Auto,*" RowSpacing="0">
                  <Border Classes="search-surface">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                      <Grid x:Name="SearchAddressBand" RowDefinitions="Auto,Auto" ColumnDefinitions="*" RowSpacing="8">
                        <Grid x:Name="AddressControlsGroup" Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="4">
                          <Button x:Name="NavigateBackButton" Grid.Column="0" Content="&#xE72B;" Classes="side-pane-action command-show" Command="{Binding DataContext.NavigateBackCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip.Tip="Back" />
                          <Button x:Name="NavigateForwardButton" Grid.Column="1" Content="&#xE72A;" Classes="side-pane-action command-show" Command="{Binding DataContext.NavigateForwardCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip.Tip="Forward" />
                          <Button x:Name="NavigateUpButton" Grid.Column="2" Content="&#xE74A;" Classes="side-pane-action command-open" Command="{Binding DataContext.NavigateUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip.Tip="Up one folder" />
                          <TextBlock x:Name="AddressModeLabel" Grid.Column="3" Text="Browse" Classes="field-label" VerticalAlignment="Center" IsVisible="False" />
                          <TextBox x:Name="AddressTextBox" Grid.Column="4"
                                   Classes="location-box"
                                   Watermark="Address"
                                   Text="{Binding DataContext.BrowserLocation, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                   GotFocus="BrowserLocationGotFocus"
                                   KeyDown="BrowserLocationKeyDown" />
                        </Grid>
                        <Border x:Name="AddressSearchDivider" Classes="address-search-divider" IsVisible="False" />
                        <Grid x:Name="SearchControlsGroup" Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                          <TextBox Grid.Column="0"
                                   Classes="search-box"
                                   MinWidth="180"
                                   Watermark="Search file and folder names"
                                   Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                   GotFocus="SearchTabGotFocus"
                                   KeyDown="SearchTabKeyDown" />
                          <Button Grid.Column="1" x:Name="RecentSearchToggle" Content="&#xE81C;" Classes="toolbar-icon"
                                  Click="RecentSearchToggle_Click"
                                  ToolTip.Tip="Recent searches" />
                        <Popup IsOpen="{Binding DataContext.IsRecentSearchesOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}"
                               Placement="Bottom"
                               PlacementTarget="{Binding #RecentSearchToggle}"
                               IsLightDismissEnabled="True"
                               OverlayDismissEventPassThrough="True"
                               Closed="RecentSearchPopup_Closed">
                          <Border Classes="side-pane" Width="260" Padding="8">
                            <ListBox ItemsSource="{Binding DataContext.RecentSearches, RelativeSource={RelativeSource AncestorType=Window}}"
                                     SelectionChanged="RecentSearchSelected">
                              <ListBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>
                          </Border>
                        </Popup>
                          <Button Grid.Column="2" Content="Clear" Command="{Binding ClearCommand}" />
                          <Button Grid.Column="3" Content="Stop" Command="{Binding StopCommand}" IsEnabled="{Binding IsSearching}" />
                          <Button Grid.Column="4" Classes="primary" Content="Search" Command="{Binding SearchCommand}" IsDefault="True" />
                        </Grid>
                      </Grid>
                      <Grid x:Name="FilterControlsGrid"
                            Grid.Row="1"
                            RowDefinitions="Auto,Auto"
                            ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                            RowSpacing="8"
                            ColumnSpacing="8">
                        <CheckBox x:Name="ExactMatchFilter" Grid.Row="0" Grid.Column="0" Content="Exact match" IsChecked="{Binding ExactMatch}" />
                        <CheckBox x:Name="SearchContentsFilter" Grid.Row="0" Grid.Column="1" Content="Search contents" IsChecked="{Binding SearchContents}" />
                        <ToggleButton x:Name="TypeFilterToggle" Grid.Row="0" Grid.Column="2" Content="{Binding TypeFilterSummary}" Width="140" IsChecked="{Binding IsTypeFilterOpen}" ToolTip.Tip="Filter by one or more file types" />
                        <Popup IsOpen="{Binding IsTypeFilterOpen, Mode=TwoWay}"
                               Placement="Bottom"
                               PlacementTarget="{Binding #TypeFilterToggle}"
                               HorizontalOffset="12"
                               IsLightDismissEnabled="True"
                               OverlayDismissEventPassThrough="True"
                               Closed="TypeFilterPopup_Closed">
                          <Border Classes="side-pane" Width="220" Padding="10">
                            <StackPanel Spacing="6">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="File types" Classes="panel-title" />
                                <Button Grid.Column="1" Content="Clear" Classes="panel-action" Command="{Binding ClearFiltersCommand}" />
                              </Grid>
                              <ItemsControl ItemsSource="{Binding TypeFilterOptions}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <Button Content="Apply" HorizontalAlignment="Right" Classes="panel-action" Click="ApplyTypeFilters_Click" />
                            </StackPanel>
                          </Border>
                        </Popup>
                        <ComboBox x:Name="DatePresetFilter" Grid.Row="0" Grid.Column="3" Width="116" ItemsSource="{Binding DatePresets}" SelectedItem="{Binding SelectedDatePreset}" />
                        <TextBlock x:Name="FromFilterLabel" Grid.Row="0" Grid.Column="4" Text="From" Classes="field-label" VerticalAlignment="Center" />
                        <CalendarDatePicker x:Name="DateFromFilter" Grid.Row="0" Grid.Column="5" Width="116"
                                            SelectedDate="{Binding DateFrom, Mode=TwoWay}"
                                            DisplayDateStart="{Binding MinimumSearchDate}"
                                            DisplayDateEnd="{Binding Today}"
                                            Watermark="Any date" />
                        <TextBlock x:Name="ToFilterLabel" Grid.Row="0" Grid.Column="6" Text="To" Classes="field-label" VerticalAlignment="Center" />
                        <CalendarDatePicker x:Name="DateToFilter" Grid.Row="0" Grid.Column="7" Width="116"
                                            SelectedDate="{Binding DateTo, Mode=TwoWay}"
                                            DisplayDateStart="{Binding MinimumSearchDate}"
                                            DisplayDateEnd="{Binding Today}"
                                            Watermark="Today" />
                        <Button x:Name="ClearFiltersButton" Grid.Row="0" Grid.Column="8" Content="Clear filters" Classes="panel-action" Command="{Binding ClearFiltersCommand}" />
                        <TextBlock x:Name="ScopeFilterLabel" Grid.Row="1" Grid.Column="0" Text="Scope" Classes="field-label" VerticalAlignment="Center" />
                        <ComboBox x:Name="ScopeFilter" Grid.Row="1" Grid.Column="1" Width="132" ItemsSource="{Binding SearchScopes}" SelectedItem="{Binding SelectedScope}" />
                        <TextBlock x:Name="ArrangeFilterLabel" Grid.Row="1" Grid.Column="2" Text="Arrange" Classes="field-label" VerticalAlignment="Center" />
                        <ComboBox x:Name="ArrangeFilter" Grid.Row="1" Grid.Column="3" Width="140" ItemsSource="{Binding SortModes}" SelectedItem="{Binding SelectedSortMode}" />
                        <TextBlock x:Name="ViewFilterLabel" Grid.Row="1" Grid.Column="4" Text="View" Classes="field-label" VerticalAlignment="Center" />
                        <ComboBox x:Name="ViewFilter" Grid.Row="1" Grid.Column="5" Width="130" ItemsSource="{Binding ViewModes}" SelectedItem="{Binding SelectedViewMode}" />
                        <Button x:Name="LoadMoreButton" Grid.Row="1" Grid.Column="6" Content="Load more" Classes="panel-action" Command="{Binding LoadMoreCommand}" />
                      </Grid>
                      <ProgressBar Grid.Row="2" Height="3" Minimum="0" Maximum="1" Value="0.6" IsIndeterminate="{Binding IsSearching}" IsVisible="{Binding IsSearching}" />
                    </Grid>
                  </Border>

                  <Grid x:Name="ResultLayoutGrid" Grid.Row="1" ColumnDefinitions="238,6,*,6,280">
                    <Border Grid.Column="0" Classes="side-pane favorites-pane" MinWidth="120" IsVisible="{Binding DataContext.IsFavoritesVisible, RelativeSource={RelativeSource AncestorType=Window}}">
                      <Grid x:Name="FavoritesNavigationGrid" RowSpacing="8">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="3*" MinHeight="160" />
                          <RowDefinition Height="6" />
                          <RowDefinition Height="2*" MinHeight="180" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" MinHeight="140" RowDefinitions="Auto,*,Auto" RowSpacing="8">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                          <TextBlock Text="★ Favorites" Classes="panel-title" VerticalAlignment="Center" />
                          <Button Grid.Column="1" Content="&#xE72C;" Classes="side-pane-action" Command="{Binding DataContext.RefreshFavoritesCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip.Tip="Refresh Favorites" />
                          <Button Grid.Column="2" Content="&#xE711;" Classes="side-pane-action" Command="{Binding DataContext.ToggleFavoritesCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip.Tip="Hide Favorites" />
                        </Grid>
                        <TreeView Grid.Row="1"
                                  ItemsSource="{Binding DataContext.FavoriteTree, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding DataContext.SelectedFavoriteNode, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  SelectionChanged="FavoriteSelectionChanged"
                                  DoubleTapped="FavoriteDoubleTapped"
                                  PointerPressed="FavoritePointerPressed">
                          <TreeView.Styles>
                            <Style Selector="TreeViewItem">
                              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                          </TreeView.Styles>
                          <TreeView.ContextMenu>
                            <ContextMenu Opened="FavoriteContextMenu_Opened">
                              <MenuItem Header="Open" Tag="open" Click="FavoriteOpen_Click" />
                              <MenuItem Header="Show in File Explorer" Tag="show" Click="FavoriteShow_Click" />
                              <MenuItem Header="Copy full path" Tag="copy" Click="FavoriteCopyPath_Click" />
                              <MenuItem Header="Version history" Tag="versions" Click="FavoriteVersionHistory_Click" />
                              <MenuItem Header="Add to group" Tag="group" Click="FavoriteAddToGroup_Click" />
                              <Separator Tag="result-separator" />
                              <MenuItem Header="Remove favorite" Tag="remove" Click="FavoriteRemove_Click" />
                              <MenuItem Header="Delete group" Tag="delete-group" Click="FavoriteDeleteGroup_Click" />
                            </ContextMenu>
                          </TreeView.ContextMenu>
                          <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}">
                              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ToolTip}" />
                            </TreeDataTemplate>
                          </TreeView.ItemTemplate>
                        </TreeView>
                        <TextBlock Grid.Row="2" Text="Favorites are personal to this Windows user." Classes="field-label" TextWrapping="Wrap" />
                        </Grid>
                        <GridSplitter Grid.Row="1" Height="6" Classes="side-pane-divider" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" />
                        <Grid Grid.Row="2" MinHeight="160" RowDefinitions="Auto,Auto,*" RowSpacing="8">
                          <TextBlock Text="Navigation" Classes="panel-title" VerticalAlignment="Center" />
                          <TextBlock Grid.Row="1"
                                     Text="{Binding DataContext.NasNavigationStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Classes="field-label"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding DataContext.ShowNasNavigationStatus, RelativeSource={RelativeSource AncestorType=Window}}" />
                          <TreeView Grid.Row="2"
                                  ItemsSource="{Binding DataContext.NavigationRoots, RelativeSource={RelativeSource AncestorType=Window}}"
                                  PointerReleased="NavigationTreePointerReleased">
                          <TreeView.Styles>
                            <Style Selector="TreeViewItem">
                              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                          </TreeView.Styles>
                          <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}">
                              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsPlaceholder}">
                                <Grid Width="18" Height="18">
                                  <TextBlock Text="{Binding Glyph}" Classes="file-glyph" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  <Image Source="{Binding IconSource}" Width="18" Height="18" Stretch="Uniform" />
                                </Grid>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding FullPath}" />
                              </StackPanel>
                            </TreeDataTemplate>
                          </TreeView.ItemTemplate>
                        </TreeView>
                        </Grid>
                      </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="6" Classes="side-pane-divider" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" IsVisible="{Binding DataContext.IsFavoritesVisible, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <GridSplitter Grid.Column="3" Width="6" Classes="side-pane-divider" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" IsVisible="{Binding DataContext.IsPreviewVisible, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <Border Grid.Column="4" Classes="side-pane preview-pane" MinWidth="220" IsVisible="{Binding DataContext.IsPreviewVisible, RelativeSource={RelativeSource AncestorType=Window}}">
                      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                          <TextBlock Text="Preview" Classes="panel-title" VerticalAlignment="Center" />
                          <Button Grid.Column="1" Content="&#xE711;" Classes="side-pane-action" Command="{Binding DataContext.TogglePreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip.Tip="Hide Preview" />
                        </Grid>
                        <Grid Grid.Row="1">
                          <StackPanel Spacing="10">
                            <TextBlock Text="{Binding DataContext.PreviewTitle, RelativeSource={RelativeSource AncestorType=Window}}" Classes="preview-title" />
                            <TextBlock Text="{Binding DataContext.PreviewDescription, RelativeSource={RelativeSource AncestorType=Window}}" Classes="field-label" />
                            <TextBlock Text="{Binding DataContext.PreviewLocation, RelativeSource={RelativeSource AncestorType=Window}}" Classes="preview-path" />
                          </StackPanel>
                          <ContentControl Content="{Binding DataContext.NativePreviewHost, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Grid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                          <Button Content="&#xE8E5;" Classes="side-pane-action command-open" Command="{Binding OpenCommand}" ToolTip.Tip="Open selected item" />
                          <Button Content="&#xE8B7;" Classes="side-pane-action command-show" Command="{Binding BrowseCommand}" ToolTip.Tip="Show selected item in File Explorer" />
                          <Button Content="&#xE81C;" Classes="side-pane-action command-preview" Click="VersionHistory_Click" ToolTip.Tip="Version history" />
                        </StackPanel>
                      </Grid>
                    </Border>

                    <Grid Grid.Column="2" MinWidth="340">
                      <Grid IsVisible="{Binding DataContext.IsSearchContentVisible, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Border Classes="result-surface" IsVisible="{Binding HasResults, FallbackValue=False}">
                          <DataGrid Classes="results-grid"
                                    x:Name="DetailsResultsGrid"
                                    ItemsSource="{Binding Results}"
                                    SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                                    AutoGenerateColumns="False"
                                    IsReadOnly="True"
                                    SelectionMode="Extended"
                                    CanUserResizeColumns="True"
                                    CanUserSortColumns="True"
                                    GridLinesVisibility="None"
                                    IsVisible="{Binding IsDetailsView}"
                                    SelectionChanged="SearchResultSelected"
                                    Sorting="DetailsGrid_Sorting"
                                    DoubleTapped="SearchResultDoubleTapped"
                                    PointerPressed="ResultPointerPressed">
                            <DataGrid.ContextMenu>
                              <ContextMenu Opened="ResultContextMenu_Opened">
                                <MenuItem Header="Open" Tag="open" Click="ResultOpen_Click" />
                                <MenuItem Header="Show in File Explorer" Tag="show" Click="ResultShow_Click" />
                                <MenuItem Header="Copy full path" Tag="copy" Click="ResultCopyPath_Click" />
                                <MenuItem Header="Properties" Tag="properties" Click="ResultProperties_Click" />
                                <MenuItem Header="Version history" Tag="versions" Click="ResultVersionHistory_Click" />
                                <Separator />
                                <MenuItem Header="Add or remove Favorite" Tag="favorite" Click="ResultFavorite_Click" />
                                <MenuItem Header="Add to group" Tag="group" Click="ResultAddToGroup_Click" />
                                <Separator />
                                <MenuItem Header="Columns" Tag="columns">
                                  <MenuItem Header="Name" Tag="column:name" ToggleType="CheckBox" Click="ToggleDetailColumn_Click" />
                                  <MenuItem Header="Location" Tag="column:location" ToggleType="CheckBox" Click="ToggleDetailColumn_Click" />
                                  <MenuItem Header="Date modified" Tag="column:modified" ToggleType="CheckBox" Click="ToggleDetailColumn_Click" />
                                  <MenuItem Header="Type" Tag="column:type" ToggleType="CheckBox" Click="ToggleDetailColumn_Click" />
                                  <MenuItem Header="Size" Tag="column:size" ToggleType="CheckBox" Click="ToggleDetailColumn_Click" />
                                </MenuItem>
                              </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                              <DataGridTemplateColumn Header="Name" SortMemberPath="name" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                  <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                      <Grid Width="24" Height="24">
                                        <TextBlock Text="{Binding IconGlyph}" Classes="file-glyph" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding IconSource}" Width="22" Height="22" Stretch="Uniform" />
                                      </Grid>
                                      <controls:HighlightTextBlock SourceText="{Binding FileName}" HighlightQuery="{Binding DataContext.SelectedSearchTab.Query, RelativeSource={RelativeSource AncestorType=Window}}" HighlightEnabled="{Binding DataContext.Config.Behavior.HighlightMatches, RelativeSource={RelativeSource AncestorType=Window}}" HighlightBrush="{DynamicResource QSurfer.MatchHighlight}" Classes="result-name" VerticalAlignment="Center" />
                                      <Button Content="★" Classes="result-favorite" FontFamily="Segoe UI Symbol" Tag="{Binding}" Click="ToggleFavoriteResult_Click" ToolTip.Tip="Add or remove Favorite" />
                                    </StackPanel>
                                  </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                              </DataGridTemplateColumn>
                              <DataGridTemplateColumn Header="Location" SortMemberPath="location" Width="3*">
                                <DataGridTemplateColumn.CellTemplate>
                                  <DataTemplate>
                                    <controls:HighlightTextBlock SourceText="{Binding DisplayPath}" HighlightQuery="{Binding DataContext.SelectedSearchTab.Query, RelativeSource={RelativeSource AncestorType=Window}}" HighlightEnabled="{Binding DataContext.Config.Behavior.HighlightMatches, RelativeSource={RelativeSource AncestorType=Window}}" HighlightBrush="{DynamicResource QSurfer.MatchHighlight}" TextTrimming="CharacterEllipsis" />
                                  </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                              </DataGridTemplateColumn>
                              <DataGridTextColumn Header="Date modified" SortMemberPath="modified" Binding="{Binding Modified}" Width="150" />
                              <DataGridTextColumn Header="Type" SortMemberPath="type" Binding="{Binding Kind}" Width="130" />
                              <DataGridTextColumn Header="Size" SortMemberPath="size" Binding="{Binding SizeText}" Width="95" />
                            </DataGrid.Columns>
                          </DataGrid>
                        </Border>

                        <Border Classes="result-surface" IsVisible="{Binding IsListView}">
                          <ListBox Classes="result-list"
                                   ItemsSource="{Binding Results}"
                                   SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                                   SelectionChanged="SearchResultSelected"
                                   DoubleTapped="SearchResultDoubleTapped">
                            <ListBox.ItemTemplate>
                              <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="10,7">
                                  <Grid Width="24" Height="24" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IconGlyph}" Classes="file-glyph" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding IconSource}" Width="22" Height="22" Stretch="Uniform" />
                                  </Grid>
                                  <StackPanel Grid.Column="1" Spacing="2">
                                    <controls:HighlightTextBlock SourceText="{Binding FileName}" HighlightQuery="{Binding DataContext.SelectedSearchTab.Query, RelativeSource={RelativeSource AncestorType=Window}}" HighlightEnabled="{Binding DataContext.Config.Behavior.HighlightMatches, RelativeSource={RelativeSource AncestorType=Window}}" HighlightBrush="{DynamicResource QSurfer.MatchHighlight}" Classes="result-name" />
                                    <controls:HighlightTextBlock SourceText="{Binding DisplayPath}" HighlightQuery="{Binding DataContext.SelectedSearchTab.Query, RelativeSource={RelativeSource AncestorType=Window}}" HighlightEnabled="{Binding DataContext.Config.Behavior.HighlightMatches, RelativeSource={RelativeSource AncestorType=Window}}" HighlightBrush="{DynamicResource QSurfer.MatchHighlight}" Classes="result-path" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Kind}" Classes="field-label" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding Modified}" Classes="result-path" HorizontalAlignment="Right" />
                                  </StackPanel>
                                </Grid>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                        </Border>

                        <Border Classes="result-surface" IsVisible="{Binding IsSmallIconView}">
                          <ListBox Classes="result-list" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}" SelectionChanged="SearchResultSelected" DoubleTapped="SearchResultDoubleTapped">
                            <ListBox.ItemsPanel>
                              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                              <DataTemplate>
                                <Border Classes="result-icon-tile" Width="138" Height="116" Margin="4">
                                  <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <Grid Width="32" Height="32" HorizontalAlignment="Center">
                                      <TextBlock Text="{Binding IconGlyph}" Classes="file-glyph" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                      <Image Source="{Binding IconSource}" Width="30" Height="30" Stretch="Uniform" />
                                    </Grid>
                                    <controls:HighlightTextBlock SourceText="{Binding FileName}" HighlightQuery="{Binding DataContext.SelectedSearchTab.Query, RelativeSource={RelativeSource AncestorType=Window}}" HighlightEnabled="{Binding DataContext.Config.Behavior.HighlightMatches, RelativeSource={RelativeSource AncestorType=Window}}" HighlightBrush="{DynamicResource QSurfer.MatchHighlight}" Classes="result-name" TextAlignment="Center" MaxWidth="120" TextWrapping="Wrap" />
                                    <controls:HighlightTextBlock SourceText="{Binding DisplayPath}" HighlightQuery="{Binding DataContext.SelectedSearchTab.Query, RelativeSource={RelativeSource AncestorType=Window}}" HighlightEnabled="{Binding DataContext.Config.Behavior.HighlightMatches, RelativeSource={RelativeSource AncestorType=Window}}" HighlightBrush="{DynamicResource QSurfer.MatchHighlight}" Classes="result-path" TextAlignment="Center" MaxWidth="120" />
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                        </Border>

                        <Border Classes="result-surface" IsVisible="{Binding IsLargeIconView}">
                          <ListBox Classes="result-list" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}" SelectionChanged="SearchResultSelected" DoubleTapped="SearchResultDoubleTapped">
                            <ListBox.ItemsPanel>
                              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                              <DataTemplate>
                                <Border Classes="result-icon-tile" Width="210" Height="180" Margin="7">
                                  <StackPanel HorizontalAlignment="Center" Spacing="8">
                                    <Grid Width="58" Height="58" HorizontalAlignment="Center">
                                      <TextBlock Text="{Binding IconGlyph}" Classes="file-glyph" FontSize="52" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                      <Image Source="{Binding IconSource}" Width="56" Height="56" Stretch="Uniform" />
                                    </Grid>
                                    <controls:HighlightTextBlock SourceText="{Binding FileName}" HighlightQuery="{Binding DataContext.SelectedSearchTab.Query, RelativeSource={RelativeSource AncestorType=Window}}" HighlightEnabled="{Binding DataContext.Config.Behavior.HighlightMatches, RelativeSource={RelativeSource AncestorType=Window}}" HighlightBrush="{DynamicResource QSurfer.MatchHighlight}" Classes="result-name" TextAlignment="Center" MaxWidth="188" TextWrapping="Wrap" />
                                    <controls:HighlightTextBlock SourceText="{Binding DisplayPath}" HighlightQuery="{Binding DataContext.SelectedSearchTab.Query, RelativeSource={RelativeSource AncestorType=Window}}" HighlightEnabled="{Binding DataContext.Config.Behavior.HighlightMatches, RelativeSource={RelativeSource AncestorType=Window}}" HighlightBrush="{DynamicResource QSurfer.MatchHighlight}" Classes="result-path" TextAlignment="Center" MaxWidth="188" />
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                        </Border>

                        <Border Classes="empty-state" IsVisible="{Binding HasNoResults}">
                          <StackPanel MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <TextBlock Text="Search shared files" Classes="empty-title" HorizontalAlignment="Center" />
                            <TextBlock Text="Enter a file or folder name above to search the NAS." TextAlignment="Center" TextWrapping="Wrap" Classes="empty-copy" />
                            <Button Content="Configure NAS connection" Click="Settings_Click" IsVisible="{Binding DataContext.NeedsConnection, RelativeSource={RelativeSource AncestorType=Window}}" />
                          </StackPanel>
                        </Border>

                      </Grid>

                      <Border Classes="result-surface browser-content" IsVisible="{Binding DataContext.IsNavigationVisible, RelativeSource={RelativeSource AncestorType=Window}}">
                          <Grid>
                            <DataGrid
                                      Classes="results-grid"
                                      IsVisible="{Binding DataContext.SelectedSearchTab.IsDetailsView, RelativeSource={RelativeSource AncestorType=Window}}"
                                      ItemsSource="{Binding DataContext.BrowserItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding DataContext.SelectedBrowserItem, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                       IsReadOnly="True"
                                       SelectionMode="Extended"
                                       CanUserResizeColumns="True"
                                       GridLinesVisibility="None"
                                       SelectionChanged="BrowserItemSelected"
                                      PointerPressed="BrowserItemPointerPressed"
                                      PointerReleased="BrowserItemPointerReleased"
                                      DoubleTapped="BrowserItemDoubleTapped">
                              <DataGrid.ContextMenu>
                                <ContextMenu Opened="BrowserContextMenu_Opened">
                                  <MenuItem Header="Open" Click="BrowserOpen_Click" />
                                  <Separator />
                                  <MenuItem Header="Cut" Tag="cut" Click="BrowserCut_Click" />
                                  <MenuItem Header="Copy" Tag="copy" Click="BrowserCopy_Click" />
                                  <MenuItem Header="Paste" Tag="paste" Click="BrowserPaste_Click" />
                                  <Separator />
                                  <MenuItem Header="Rename" Tag="rename" Click="BrowserRename_Click" />
                                  <MenuItem Header="Delete" Tag="delete" Click="BrowserDelete_Click" />
                                  <Separator />
                                  <MenuItem Header="New folder" Tag="new-folder" Click="BrowserNewFolder_Click" />
                                  <MenuItem Header="Create shortcut" Tag="shortcut" Click="BrowserShortcut_Click" />
                                  <MenuItem Header="Copy full path" Tag="copy-path" Click="BrowserCopyPath_Click" />
                                  <MenuItem Header="Properties" Tag="properties" Click="BrowserProperties_Click" />
                                  <MenuItem Header="Version history" Tag="versions" Click="BrowserVersionHistory_Click" />
                                  <Separator />
                                  <MenuItem Header="Add or remove Favorite" Click="BrowserFavorite_Click" />
                                </ContextMenu>
                              </DataGrid.ContextMenu>
                              <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Name" Width="1.4*">
                                  <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                      <StackPanel Orientation="Horizontal" Spacing="8">
                                         <Grid Width="22" Height="22">
                                           <TextBlock Text="{Binding Glyph}" Classes="file-glyph" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                           <Image Source="{Binding IconSource}" Width="22" Height="22" Stretch="Uniform" />
                                         </Grid>
                                         <TextBlock Text="{Binding Name}" Classes="result-name" VerticalAlignment="Center" />
                                      </StackPanel>
                                    </DataTemplate>
                                  </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Location" Binding="{Binding DisplayPath}" Width="2*" />
                                <DataGridTextColumn Header="Date" Binding="{Binding DisplayDate}" Width="160" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="140" />
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="95" />
                              </DataGrid.Columns>
                            </DataGrid>
                            <ListBox
                                     Classes="result-list"
                                     IsVisible="{Binding DataContext.SelectedSearchTab.IsListView, RelativeSource={RelativeSource AncestorType=Window}}"
                                     ItemsSource="{Binding DataContext.BrowserItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding DataContext.SelectedBrowserItem, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                      SelectionMode="Multiple"
                                      SelectionChanged="BrowserItemSelected"
                                     PointerPressed="BrowserItemPointerPressed"
                                     PointerReleased="BrowserItemPointerReleased"
                                     DoubleTapped="BrowserItemDoubleTapped">
                              <ListBox.ContextMenu>
                                <ContextMenu Opened="BrowserContextMenu_Opened">
                                  <MenuItem Header="Open" Click="BrowserOpen_Click" />
                                  <Separator />
                                  <MenuItem Header="Cut" Tag="cut" Click="BrowserCut_Click" />
                                  <MenuItem Header="Copy" Tag="copy" Click="BrowserCopy_Click" />
                                  <MenuItem Header="Paste" Tag="paste" Click="BrowserPaste_Click" />
                                  <Separator />
                                  <MenuItem Header="Rename" Tag="rename" Click="BrowserRename_Click" />
                                  <MenuItem Header="Delete" Tag="delete" Click="BrowserDelete_Click" />
                                  <Separator />
                                  <MenuItem Header="New folder" Tag="new-folder" Click="BrowserNewFolder_Click" />
                                  <MenuItem Header="Create shortcut" Tag="shortcut" Click="BrowserShortcut_Click" />
                                  <MenuItem Header="Copy full path" Tag="copy-path" Click="BrowserCopyPath_Click" />
                                  <MenuItem Header="Properties" Tag="properties" Click="BrowserProperties_Click" />
                                  <MenuItem Header="Version history" Tag="versions" Click="BrowserVersionHistory_Click" />
                                  <Separator />
                                  <MenuItem Header="Add or remove Favorite" Click="BrowserFavorite_Click" />
                                </ContextMenu>
                              </ListBox.ContextMenu>
                              <ListBox.ItemTemplate>
                                <DataTemplate>
                                  <Grid ColumnDefinitions="Auto,1.2*,2*,*,120,90" ColumnSpacing="10" Margin="10,5">
                                     <Grid Grid.Column="0" Width="22" Height="22">
                                       <TextBlock Text="{Binding Glyph}" Classes="file-glyph" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                       <Image Source="{Binding IconSource}" Width="22" Height="22" Stretch="Uniform" />
                                     </Grid>
                                     <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="result-name" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding DisplayPath}" Classes="field-label" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding Kind}" Classes="field-label" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding DisplayDate}" Classes="field-label" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{Binding SizeText}" Classes="field-label" VerticalAlignment="Center" TextAlignment="Right" />
                                  </Grid>
                                </DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>
                            <ListBox
                                     Classes="result-list"
                                     IsVisible="{Binding DataContext.SelectedSearchTab.IsSmallIconView, RelativeSource={RelativeSource AncestorType=Window}}"
                                     ItemsSource="{Binding DataContext.BrowserItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding DataContext.SelectedBrowserItem, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                      SelectionMode="Multiple"
                                      SelectionChanged="BrowserItemSelected"
                                     PointerPressed="BrowserItemPointerPressed"
                                     PointerReleased="BrowserItemPointerReleased"
                                     DoubleTapped="BrowserItemDoubleTapped">
                              <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                              </ListBox.ItemsPanel>
                              <ListBox.ItemTemplate>
                                <DataTemplate>
                                  <Border Classes="result-icon-tile" Width="132" Height="120" Margin="6">
                                    <StackPanel HorizontalAlignment="Center" Spacing="5">
                                       <Grid Width="42" Height="42" HorizontalAlignment="Center">
                                         <TextBlock Text="{Binding Glyph}" Classes="file-glyph" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                         <Image Source="{Binding IconSource}" Width="42" Height="42" Stretch="Uniform" />
                                       </Grid>
                                       <TextBlock Text="{Binding Name}" Classes="result-name" MaxWidth="116" TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>
                            <ListBox
                                     Classes="result-list"
                                     IsVisible="{Binding DataContext.SelectedSearchTab.IsLargeIconView, RelativeSource={RelativeSource AncestorType=Window}}"
                                     ItemsSource="{Binding DataContext.BrowserItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                     SelectedItem="{Binding DataContext.SelectedBrowserItem, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                     SelectionMode="Multiple"
                                     SelectionChanged="BrowserItemSelected"
                                     PointerPressed="BrowserItemPointerPressed"
                                     PointerReleased="BrowserItemPointerReleased"
                                     DoubleTapped="BrowserItemDoubleTapped">
                              <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                              </ListBox.ItemsPanel>
                              <ListBox.ItemTemplate>
                                <DataTemplate>
                                  <Border Classes="result-icon-tile" Width="210" Height="180" Margin="7">
                                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                                       <Grid Width="64" Height="64" HorizontalAlignment="Center">
                                         <TextBlock Text="{Binding Glyph}" Classes="file-glyph" FontSize="58" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                         <Image Source="{Binding IconSource}" Width="64" Height="64" Stretch="Uniform" />
                                       </Grid>
                                       <TextBlock Text="{Binding Name}" Classes="result-name" MaxWidth="188" TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                      <TextBlock Text="{Binding Kind}" Classes="result-path" MaxWidth="188" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>
                          </Grid>
                      </Border>
                    </Grid>
                  </Grid>
                </Grid>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </Grid>
      </Grid>

    <Border Grid.Row="3" Classes="statusbar">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="18">
        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource QSurfer.MutedForeground}" />
        <TextBlock Grid.Column="1" Text="{Binding CurrentWindowsUser}" Foreground="{DynamicResource QSurfer.MutedForeground}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2" Text="{Binding NasConnectionStatus}" Foreground="{DynamicResource QSurfer.MutedForeground}" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>
  </Grid>
</Window>
